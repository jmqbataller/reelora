PORT=3000
REELORA_DATA_DIR=.reelora

# Automatic music: when no music is supplied, prefer the verified library below,
# otherwise generate Reelora's sample-free trend-inspired original instrumental.
REELORA_AUTO_MUSIC=1
# Optional absolute/relative folder containing manifest.json + licensed/verified tracks.
REELORA_MUSIC_LIBRARY=

# Restrained transition flash accents. Set to 0 to disable.
REELORA_SUBTLE_FLASH=1
# Apply roughly one flash accent every N transitions. Higher = rarer. Safe range: 3-10.
# v0.5.1 defaults to a much sparser accent cadence for short fashion Reels.
REELORA_FLASH_CADENCE=8
# User-facing strength is clamped internally; keep the default subtle.
REELORA_FLASH_STRENGTH=0.08

# Set this when running the HTTP server publicly so MCP responses can return a downloadable output URL.
# Example: https://reelora.example.com
PUBLIC_BASE_URL=
